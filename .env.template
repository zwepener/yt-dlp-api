# --[ HTTP SERVER CONFIG ]--
#
# (Optional) Host address to bind to.
# When undefined or empty, defaults to "0.0.0.0" (all IPv4 interfaces)
#SERVER_HOST="0.0.0.0"
#
# (Optional) Host port to bind to.
# When undefined or empty, defaults to "8080"
#SERVER_PORT="8080"

# --[ YTDLP CONFIG ]--
# yt-dlp is used to resolve the urls
#
# (Optional) Path to yt-dlp binary.
# When undefined or empty, defaults to "yt-dlp" (assumes the yt-dlp binary is globally accessible)
#YTDLP_CMD="yt-dlp"
#
# (Optional) Timeout for yt-dlp requests
# When undefined or empty, defaults to "15s"
#YTDLP_TMO="15s"
#
# (Optional) Maximum number of concurrent yt-dlp processes per request
# When undefined or empty, defaults to "2"
#YTDLP_MCP="2" 

# -- [ REDIS CONFIG ]--
# Redis is used to cache resolved urls to reduce calls to external services.
#
# (Optional) Redis server address
# When undefined, caching is disabled.
# When empty, defaults to "localhost:6379"
#REDIS_ADR="localhost:6379"
#
# (Optional) Redis username
# When undefined or empty, defaults to "default"
#REDIS_USR=""
#
# (Optional) Redis password
# When undefined or empty, defaults to ""
#REDIS_PWD=""
#
# (Optional) Cache time-to-live
# When undefined or empty, defaults to "6h"
#CACHE_TTL="6h"
